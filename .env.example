# Neon PostgreSQL connection strings. Use the pooled URL for app traffic and direct URL for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Vercel Blob storage token for product image uploads (server-side only)
BLOB_READ_WRITE_TOKEN=""

# Admin allowlist, applied to DB AdminSlot rows by the seed script. Maximum three.
ADMIN_EMAILS=""

# Optional administrator phone sign-in. Do not commit the phone list or password.
ADMIN_PHONE_NUMBERS=""
ADMIN_PASSWORD=""

# Optional Google OAuth sign-in for allowlisted administrator accounts.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Local development only. In Vercel Production, use https://<production-domain>/api/auth/google/callback.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Customer email/password verification and password recovery (Resend).
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""
# Local development only. In Vercel Production, use the public HTTPS site origin.
AUTH_BASE_URL="http://localhost:3000"

# Meta WhatsApp Cloud API business notification settings
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_NOTIFICATION_NUMBER=""
WHATSAPP_SUBMISSION_TEMPLATE="sudaroli_submission_received"
# Approved template with one body placeholder ({{1}}) for the generated order summary
WHATSAPP_ORDER_TEMPLATE="sudaroli_order_notification"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_GRAPH_VERSION="v22.0"

# Protect manual POST requests to scheduled job routes
NOTIFICATION_DISPATCH_SECRET=""

# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to scheduled GET routes.
CRON_SECRET=""
